# ============================================================
# CHARON MULTI-CHAIN CONFIGURATION
# ============================================================

# Active chain: solana | base | bsc | ethereum | arbitrum
CHAIN=solana

# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# ============================================================
# WALLET KEYS
# ============================================================
# For Solana (base58 encoded private key)
SOLANA_PRIVATE_KEY=

# For EVM chains (hex private key, with or without 0x prefix)
EVM_PRIVATE_KEY=

# Or use a single PRIVATE_KEY for whichever chain is active
# PRIVATE_KEY=

# ============================================================
# SOLANA RPC
# ============================================================
HELIUS_API_KEY=
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ============================================================
# EVM RPC (optional, defaults to public RPCs)
# ============================================================
# BASE_RPC_URL=https://mainnet.base.org
# BSC_RPC_URL=https://bsc-dataseed1.binance.org
# ETH_RPC_URL=https://eth.llamarpc.com
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# ============================================================
# API KEYS
# ============================================================

# GMGN (required for token enrichment on all chains)
GMGN_ENABLED=true
GMGN_API_KEY=GMGN_R...2500
GMGN_MAX_RETRIES=2
GMGN_CACHE_TTL_MS=300000

# Jupiter (Solana only)
JUPITER_API_KEY=
JUPITER_SLIPPAGE_BPS=300

# 1inch (EVM chains: base, bsc, ethereum, arbitrum)
ONEINCH_API_KEY=

# Odos (EVM chains, optional alternative to 1inch)
ODOS_API_KEY=

# ============================================================
# RESERVES (min native token to keep in wallet)
# ============================================================
LIVE_MIN_SOL_RESERVE=0.02
LIVE_MIN_ETH_RESERVE=0.001

# ============================================================
# LLM
# ============================================================
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7
ENABLE_LLM=true

# ============================================================
# SIGNAL SERVER (optional)
# ============================================================
SIGNAL_SERVER_URL=http://localhost:3456
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# ============================================================
# POLLING INTERVALS (ms)
# ============================================================
GRADUATED_POLL_MS=30000
GRADUATED_LOOKBACK_MS=7200000
TRENDING_POLL_MS=60000
TRENDING_LOOKBACK_MS=600000
POSITION_CHECK_MS=10000
LLM_TIMEOUT_MS=60000

# ============================================================
# DATABASE
# ============================================================
DB_PATH=./charon.sqlite

# ============================================================
# SLIPPAGE (EVM chains, percentage)
# ============================================================
EVM_SLIPPAGE=1

# ============================================================
# CHAIN-SPECIFIC NOTES
# ============================================================
#
# SOLANA:
#   - Uses Jupiter Ultra API for swaps
#   - Uses Pump.fun signals (fee claims, graduated tokens)
#   - Uses Helius RPC by default
#   - Set SOLANA_PRIVATE_KEY (base58) + JUPITER_API_KEY
#
# BASE:
#   - Uses 1inch or Odos for swaps
#   - Uses DexScreener + GMGN for signals
#   - Set EVM_PRIVATE_KEY (hex) + ONEINCH_API_KEY
#
# BSC:
#   - Uses 1inch for swaps
#   - Uses DexScreener + GMGN for signals
#   - Set EVM_PRIVATE_KEY (hex) + ONEINCH_API_KEY
#
# ETHEREUM:
#   - Uses 1inch for swaps
#   - Uses DexScreener + GMGN for signals
#   - Set EVM_PRIVATE_KEY (hex) + ONEINCH_API_KEY
#
# ARBITRUM:
#   - Uses 1inch for swaps
#   - Uses DexScreener + GMGN for signals
#   - Set EVM_PRIVATE_KEY (hex) + ONEINCH_API_KEY
